  {
   "parameters": {
    "jsCode": "const novas = [{\"concessionaria\": \"CEEE\", \"ordem\": \"85\", \"gatilho\": \"Fico muito feliz de te ajudar\", \"tipo\": \"contem\", \"acao\": \"proxima\", \"resposta\": \"\", \"valor_planilha\": \"protocolo já aberto\", \"ativo\": \"sim\", \"observacao\": \"fim da conversa depois da pesquisa\"}, {\"concessionaria\": \"CEEE\", \"ordem\": \"225\", \"gatilho\": \"Muito satisfeito\", \"tipo\": \"contem\", \"acao\": \"responder\", \"resposta\": \"5\", \"valor_planilha\": \"\", \"ativo\": \"sim\", \"observacao\": \"pesquisa de satisfação com opções 1 a 5\"}, {\"concessionaria\": \"CEEE\", \"ordem\": \"950\", \"gatilho\": \"Eu sou a Clara\", \"tipo\": \"contem\", \"acao\": \"reiniciar_se_no_meio\", \"resposta\": \"\", \"valor_planilha\": \"\", \"ativo\": \"sim\", \"observacao\": \"saudação no meio da conversa = Clara reiniciou; recomeça a mesma UC\"}];\nconst tem = $('Regras').all().map(i => i.json).filter(x => x.id).map(x => x.concessionaria + '|' + x.ordem);\nreturn novas.filter(r => !tem.includes(r.concessionaria + '|' + r.ordem)).map(r => ({ json: r }));"
