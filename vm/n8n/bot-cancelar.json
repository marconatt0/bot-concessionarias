  {
   "parameters": {
    "jsCode": "let meta = null;\nconst b64 = $input.first().json.data;\nif (b64) { try { meta = JSON.parse(Buffer.from(b64, 'base64').toString('utf8')); } catch (e) {} }\nreturn [{ json: { meta } }];"
   },
   "type": "n8n-nodes-base.code",
   "typeVersion": 2,
   "position": [
    200,
    0
   ],
   "id": "b489edc9-29fc-4a1a-9e11-dbdc0e3497a6",
   "name": "Lote atual"
  },
  {
   "parameters": {
    "jsCode": "const ATIVOS = ['rodando', 'pausado', 'aguardando_expiracao'];\nconst agora = new Date().toLocaleString('pt-BR', { timeZone: 'America/Sao_Paulo' });\nconst FILAS = [['CEEE', 'Fila CEEE'], ['RGE', 'Fila RGE']];\nconst meta = $('Lote atual').first().json.meta;\nconst plano = { meta: null, CEEE: [], RGE: [], controle: [] };\nif (meta && meta.lote_id) {\n  plano.meta = { ...meta, cancelado: true, cancelado_em: agora };\n  for (const [conc, no] of FILAS) {\n    for (const r of $(no).all().map(i => i.json).filter(r => r.id && r.lote_id === meta.lote_id)) {\n      const s = String(r.situacao || '');\n      let nova = null;\n      if (s.startsWith('aguardando_fim:')) nova = s.slice('aguardando_fim:'.length);\n      else if (s === 'em_andamento') nova = 'interrompida';\n      if (nova) plano[conc].push({ id: r.id, situacao: nova, atualizado_em: agora });\n    }\n  }\n  plano.controle = $('Controle').all().map(i => i.json)\n    .filter(r => r.id && ATIVOS.includes(r.status))\n    .map(r => ({ id: r.id, status: 'cancelado', pausado_ate_ms: '' }));\n}\nreturn [{ json: { plano, resposta: { ok: true } } }];"
   },
   "type": "n8n-nodes-base.code",
   "typeVersion": 2,
   "position": [
    400,
    0
   ],
