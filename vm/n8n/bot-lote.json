   "name": "Controle",
   "executeOnce": true,
   "alwaysOutputData": true
  },
  {
   "parameters": {
    "jsCode": "const ATIVOS = ['rodando', 'pausado', 'aguardando_expiracao'];\nconst agora = new Date().toLocaleString('pt-BR', { timeZone: 'America/Sao_Paulo' });\nconst body = $('Webhook').first().json.body || {};\nconst ctrl = $('Controle').all().map(i => i.json).filter(r => r.id);\nconst ocupada = ctrl.find(r => ATIVOS.includes(r.status));\nconst linhas = (Array.isArray(body.linhas) ? body.linhas : [])\n  .filter(l => ['CEEE', 'RGE'].includes(l.concessionaria) && String(l.uc_nova || '').trim());\nlet erro = '', codigo = 200;\nif (ocupada) { erro = `Já existe um lote em andamento (fila ${ocupada.concessionaria}: ${ocupada.status}).`; codigo = 409; }\nelse if (!body.lote_id || !linhas.length) { erro = 'Pedido sem lote_id ou sem linhas de CEEE/RGE.'; codigo = 400; }\nelse if (!body.arquivo_b64) { erro = 'Pedido sem o arquivo da planilha.'; codigo = 400; }\nconst lote_id = String(body.lote_id || '');\nreturn [{ json: {\n  ok: !erro, codigo,\n  resposta: erro ? { ok: false, erro } : { ok: true, lote_id, linhas: linhas.length },\n  lote_id, linhas,\n  meta: { lote_id, arquivo_nome: String(body.arquivo_nome || 'planilha.xlsx'),\n          enviado_por: String(body.enviado_por || ''), enviado_em: agora, cancelado: false },\n} }];"
   },
   "type": "n8n-nodes-base.code",
   "typeVersion": 2,
   "position": [
    -400,
    0
   ],
   "id": "662be5ae-ac36-4135-a745-5aa99f64ec31",
   "name": "Validar"
  },
  {
