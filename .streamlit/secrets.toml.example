# Copie o conteúdo para Settings > Secrets do app no Streamlit Cloud
# (ou para .streamlit/secrets.toml localmente — esse arquivo não vai para o git).

# demo = true   # liga o modo demonstração (não fala com o n8n)

[n8n]
url = "https://SEU-DOMINIO.ngrok-free.app"   # domínio estático do ngrok, sem /webhook
token = "TROQUE-POR-UM-TOKEN-LONGO"           # mesmo valor de BOT_TOKEN no .env da VM

[usuarios]
# usuário = hash bcrypt da senha. Gere com:
#   python -c "import bcrypt,getpass; print(bcrypt.hashpw(getpass.getpass().encode(), bcrypt.gensalt()).decode())"
InfraRS = "$2b$12$COLE-O-HASH-AQUI"
